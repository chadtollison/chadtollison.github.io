  {"text": "password=Hunter2!xyz pwd: \"correct-horse-battery\" secret=${SECRET} token: null",
   "expect": [["PASSWORD", "Hunter2!xyz"], ["PASSWORD", "correct-horse-battery"]]},
  {"text": "password = input.value; token = getToken(); api_key: ********",
   "expect": []},
  {"text": "postgres://admin:S3cr3tPass@db.internal:5432/app",
   "expect": [["PASSWORD", "S3cr3tPass"]]},
  {"text": "Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U",
   "expect": [["API_KEY", "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U"]]},
  {"text": "user=jalvarez login: root author=dev.lee@acme.io",
