  {"text": "Order 2147483647 and phone 6626341142",
   "expect": [["PHONE", "6626341142"]]},
  {"text": "Born on 04/12/1985. DOB: March 3, 1990",
   "expect": [["DATE_OF_BIRTH", "04/12/1985"], ["DATE_OF_BIRTH", "March 3, 1990"]]},
