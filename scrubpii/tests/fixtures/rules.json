  {"text": "{\"name\": \"Priya Raman\", \"first_name\": \"Priya\", \"name\": \"Build\"}",
   "expect": [["PERSON", "Priya Raman"], ["PERSON", "Priya"]]},
  {"text": "Find me on linkedin.com/in/priya-raman-88 or https://x.com/priya_r. Repo: github.com/acme/app",
