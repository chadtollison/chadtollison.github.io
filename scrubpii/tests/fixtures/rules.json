  {"text": "SSN 123-45-6789, also written 123.45.6789 or 123 45 6789.",
   "expect": [["SSN", "123-45-6789"], ["SSN", "123.45.6789"], ["SSN", "123 45 6789"]]},
  {"text": "ssn: 123456789 and social security number 234-56-7890",
   "expect": [["SSN", "123456789"], ["SSN", "234-56-7890"]]},
